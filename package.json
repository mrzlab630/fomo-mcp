{
  "name": "fomo-mcp",
  "version": "0.1.1",
  "private": true,
  "description": "Read-only FOMO data MCP gateway with replaceable transports and encrypted auth state",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:daemon": "node dist/daemon.js",
    "auth:keygen": "node dist/cli.js auth:keygen",
    "auth:import": "node dist/cli.js auth:import",
    "auth:status": "node dist/cli.js auth:status",
    "auth:refresh": "node dist/cli.js auth:refresh",
    "endpoints:discover": "node dist/cli.js endpoints:discover",
    "endpoints:check": "node dist/cli.js endpoints:check",
    "endpoints:refresh": "node dist/cli.js endpoints:refresh",
    "docs:api": "node scripts/generate-api-doc.mjs",
    "test:endpoints": "node --test tests/*.test.mjs",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --only fomo-mcp-daemon --update-env",
    "pm2:restart": "npm run build && pm2 restart fomo-mcp-daemon --update-env",
    "pm2:stop": "pm2 stop fomo-mcp-daemon",
    "pm2:logs": "pm2 logs fomo-mcp-daemon",
    "pm2:status": "pm2 status fomo-mcp-daemon"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
